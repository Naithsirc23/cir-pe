[Unit]
Description=CIR Projects private read-only API
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/cris/GITHUBS/DASHBOARDCIR
EnvironmentFile=/home/cris/.config/cir-private-api/env
ExecStart=/usr/bin/env bash -lc 'exec pnpm private:api'
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
